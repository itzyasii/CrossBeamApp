{
  "name": "crossbeam-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "dev:web": "expo start --web",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:local": "eas build --platform android --local",
    "build:ios:local": "eas build --platform ios --local",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint App.tsx src --ext .ts,.tsx",
    "lint:fix": "eslint App.tsx src --ext .ts,.tsx --fix",
    "validate": "npm run typecheck && npm run lint && npm test && npm run doctor",
    "android:lint": "node scripts/run-gradle.js :app:lintRelease",
    "android:bundle": "node scripts/run-gradle.js :app:bundleRelease",
    "android:apk": "node scripts/build-android-apk.js",
    "android:apk:all": "node scripts/build-android-apk.js --all",
    "clean": "npx expo-modules-core clean",
    "reset": "npx expo start --clear && watchman watch-del-all",
    "doctor": "npx expo-doctor",
    "ins": "npm install --legacy-peer-deps",
    "ci": "npm ci --legacy-peer-deps"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "crossbeam-native": "file:modules/crossbeam-native",
    "date-fns": "^3.0.0",
    "expo": "~55.0.29",
    "expo-application": "~55.0.18",
    "expo-asset": "~55.0.18",
    "expo-bluetooth": "^0.0.0",
    "expo-blur": "~55.0.17",
    "expo-camera": "~55.0.22",
    "expo-clipboard": "~55.0.16",
    "expo-device": "~55.0.20",
    "expo-document-picker": "~55.0.16",
    "expo-file-system": "~55.0.22",
    "expo-haptics": "~55.0.17",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.17",
    "expo-local-authentication": "~55.0.17",
    "expo-location": "~55.1.13",
    "expo-navigation-bar": "~55.0.16",
    "expo-network": "~55.0.17",
    "expo-notifications": "~55.0.26",
    "expo-screen-orientation": "~55.0.19",
    "expo-share-intent": "^6.1.0",
    "expo-sharing": "~55.0.23",
    "expo-splash-screen": "~55.0.24",
    "expo-sqlite": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.21",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-paper": "^5.12.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-vector-icons": "^10.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^20.10.6",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^8.56.0",
    "expo-doctor": "^1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.21",
    "typescript": "~5.9.2"
  },
  "expo": {
    "plugins": [
      [
        "expo-file-system"
      ]
    ],
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  }
}
